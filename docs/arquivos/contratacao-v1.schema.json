{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "versao": {
      "type": "string",
      "const": "1.0"
    },
    "loteId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "origem": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "documento": {
              "type": "string",
              "maxLength": 300
            },
            "referencia": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["documento"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "tipo": {
      "type": "string",
      "const": "itens_contratacao"
    },
    "itens": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": ["MATERIAL", "SERVICO"]
          },
          "descricao": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20000
          },
          "marca": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "modelo": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "unidade": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "numero": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999
          },
          "quantidade": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^\\d+(?:\\.\\d{1,3})?$"
          },
          "valorUnitarioEstimado": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60,
                "pattern": "^\\d+(?:\\.\\d{1,4})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "catalogoId": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "format": "cuid",
                "pattern": "^[cC][0-9a-z]{6,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "catalogoReferencia": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "loteId": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9._-]+$"
                  },
                  "codigo": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": ["loteId", "codigo"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["tipo", "descricao", "unidade", "numero", "quantidade"],
        "additionalProperties": false
      }
    }
  },
  "required": ["versao", "loteId", "tipo", "itens"],
  "additionalProperties": false
}
