# Neon: URL pooled de aplicação; TLS obrigatório no Neon.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-HOST-pooler.neon.tech/govnex?sslmode=verify-full"
# URL direta, sem -pooler, para migrations. Não reutilize produção nos testes.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/govnex?sslmode=verify-full"
# Gere: openssl rand -base64 48. Nunca use um segredo de exemplo.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Somente banco DESCARTÁVEL de teste para npm run test:integration.
TEST_DATABASE_URL=""

# Agendamento das notificações: gere um segredo aleatório de ao menos 32 caracteres.
# Usado somente no servidor, no header Authorization: Bearer <segredo>.
CRON_SECRET=""
