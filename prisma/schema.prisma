generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum OrganizationRole {
  PUBLIC_AGENCY
  SUPPLIER
}

model User {
  id             String      @id @default(cuid())
  name           String
  email          String      @unique
  passwordHash   String
  role           Role        @default(USER)
  active         Boolean     @default(true)
  sessionVersion Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tasks          Task[]
  eventReads     EventRead[]
  auditLogs      AuditLog[]
}

model Organization {
  id                 String                   @id @default(cuid())
  legalName          String
  tradeName          String?
  acronym            String?
  cnpj               String?                  @unique
  uasg               String?
  roles              OrganizationRole[]
  email              String?
  phone              String?
  address            String?
  postalCode         String?
  city               String?
  state              String?
  categories         String[]                 @default([])
  notes              String?
  active             Boolean                  @default(true)
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  contractCases      ContractCase[]
  instruments        Contract[]
  contacts           Contact[]
  opportunities      Opportunity[]
  catalogMemberships CatalogSupplier[]
  catalogProducts    CatalogProduct[]         @relation("CatalogSupplier")
  suppliedItems      OpportunityItem[]        @relation("ItemSupplier")
  tasks              Task[]
  participations     OpportunityParticipant[]

  @@index([legalName])
  @@index([roles], type: Gin)
}

model Contact {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tasks          Task[]
  name           String
  position       String?
  email          String?       @unique
  phone          String?
  phones         Json          @default("[]")
  notes          String?
  linkedInUrl    String?

  @@index([organizationId])
  @@index([createdAt, id])
}

model CompanySettings {
  id         String   @id @default("company")
  legalName  String   @default("Govnex Soluções Digitais Ltda.")
  tradeName  String   @default("Govnex")
  cnpj       String?
  email      String?
  phone      String?
  address    String?
  postalCode String?
  city       String?
  state      String?
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entity    String
  entityId  String?
  action    String
  changes   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
}

model LoginAttempt {
  key         String   @id
  attempts    Int      @default(1)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

enum LegacyOpportunityStatus {
  DRAFT
  OPEN
  IN_ANALYSIS
  QUOTATION
  PROPOSAL
  CLOSED
  CANCELLED

  @@map("OpportunityStatus")
}

enum ProcurementMethod {
  UNDEFINED
  ELECTRONIC_AUCTION
  IN_PERSON_AUCTION
  ELECTRONIC_WAIVER
  WAIVER
  INEXIGIBILITY
  COMPETITION
  OTHER
}

enum ItemType {
  MATERIAL
  SERVICE
}

enum ContractingStatus {
  IN_ANALYSIS
  CLASSIFIED
  CANCELLED
  SUSPENDED
  HOMOLOGATED
  PROPOSAL_REGISTERED
  CLOSED
}

model Opportunity {
  id                   String                   @id @default(cuid())
  reference            String                   @unique
  organizationId       String
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subject              String
  procurementMethod    ProcurementMethod        @default(UNDEFINED)
  processNumber        String?
  estimatedValue       Decimal?                 @map("itemsEstimatedValue") @db.Decimal(18, 2)
  legacyEstimatedValue Decimal?                 @map("estimatedValue") @db.Decimal(18, 2)
  proposalDeadline     DateTime?                @db.Timestamptz(3)
  status               ContractingStatus        @default(IN_ANALYSIS) @map("contractingStatus")
  legacyStatus         LegacyOpportunityStatus  @default(OPEN) @map("status")
  platformUrl          String?
  attachmentsUrl       String?
  legacySourceUrl      String?                  @map("sourceUrl")
  notes                String?
  archived             Boolean                  @default(false)
  version              Int                      @default(1)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  contractCases        ContractCase[]
  contracts            Contract[]
  items                OpportunityItem[]
  tasks                Task[]
  isSrp                Boolean                  @default(false)
  priceRegistrations   PriceRegistration[]
  participants         OpportunityParticipant[]

  @@index([organizationId, processNumber])
  @@index([archived, legacyStatus, proposalDeadline], map: "Opportunity_archived_status_proposalDeadline_idx")
  @@index([archived, status, proposalDeadline], map: "Opportunity_archived_contractingStatus_proposalDeadline_idx")
  @@index([createdAt])
}

model OpportunityItem {
  type                      ItemType?
  winner                    Boolean                 @default(false)
  taxRate                   Decimal?                @db.Decimal(5, 2)
  acquisitionUnit           Decimal?                @db.Decimal(18, 4)
  freightUnit               Decimal?                @db.Decimal(18, 4)
  netProfitRate             Decimal?                @db.Decimal(5, 2)
  pricingAdministrativeRate Decimal?                @db.Decimal(5, 2)
  minimumPrice              Decimal?                @db.Decimal(18, 4)
  pricingSnapshot           Json?
  winningUnitPrice          Decimal?                @db.Decimal(18, 4)
  id                        String                  @id @default(cuid())
  opportunityId             String
  opportunity               Opportunity             @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  catalogProductId          String?
  catalogProduct            CatalogProduct?         @relation(fields: [catalogProductId], references: [id], onDelete: Restrict)
  brand                     String?
  model                     String?
  margin                    Decimal?                @db.Decimal(5, 2)
  administrativeCost        Decimal?                @db.Decimal(5, 2)
  contractedItems           ContractItem[]
  supplierId                String?
  supplier                  Organization?           @relation("ItemSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  number                    Int
  description               String
  unit                      String                  @default("UN")
  quantity                  Decimal                 @db.Decimal(18, 3)
  unitPrice                 Decimal?                @db.Decimal(18, 4)
  total                     Decimal?                @db.Decimal(18, 2)
  registeredItems           PriceRegistrationItem[]

  @@unique([opportunityId, number])
  @@unique([id, opportunityId])
}

model CatalogProduct {
  type               ItemType?
  taxRate            Decimal?          @db.Decimal(5, 2)
  suppliers          CatalogSupplier[]
  id                 String            @id @default(cuid())
  description        String
  brand              String?
  model              String?
  unit               String
  margin             Decimal           @default(0) @db.Decimal(5, 2)
  administrativeCost Decimal           @default(0) @db.Decimal(5, 2)
  supplierId         String
  supplier           Organization      @relation("CatalogSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  active             Boolean           @default(true)
  version            Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  items              OpportunityItem[]

  @@index([supplierId])
}

model CatalogSupplier {
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Organization   @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@id([catalogProductId, supplierId])
  @@index([supplierId])
}

enum InstrumentType {
  TERM
  COMMITMENT
}

enum InstrumentStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

model ContractCase {
  id                   String                @id @default(cuid())
  reference            String                @unique
  opportunityId        String?
  opportunity          Opportunity?          @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationSnapshot Json
  version              Int                   @default(1)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  instruments          Contract[]
  items                ContractItem[]
  orders               SupplyOrder[]
  invoices             SalesInvoice[]
  guarantees           ContractGuarantee[]
  periods              ContractPeriod[]
  endorsements         ContractEndorsement[]
  amendments           ContractAmendment[]

  @@index([organizationId])
  @@index([opportunityId])
}

model Contract {
  id                   String                @id @default(cuid())
  opportunityId        String?
  opportunity          Opportunity?          @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseId               String
  case                 ContractCase          @relation(fields: [caseId], references: [id], onDelete: Restrict)
  parentTermId         String?
  parentTerm           Contract?             @relation("LinkedCommitments", fields: [parentTermId, caseId], references: [id, caseId], onDelete: Restrict, onUpdate: NoAction)
  commitments          Contract[]            @relation("LinkedCommitments")
  substitutive         Boolean               @default(true)
  publicationUrl       String?
  instrumentType       InstrumentType?
  reference            String
  issuedAt             DateTime?             @db.Date
  amount               Decimal?              @db.Decimal(18, 2)
  initialCurrentAmount Decimal?              @db.Decimal(18, 2)
  currentAmount        Decimal?              @db.Decimal(18, 2)
  continuous           Boolean               @default(false)
  status               InstrumentStatus      @default(DRAFT)
  signatureDate        DateTime?             @db.Date
  validFrom            DateTime?             @db.Date
  validUntil           DateTime?             @db.Date
  commitmentReference  String?
  supplyDeadline       DateTime?             @db.Date
  documentUrl          String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  orders               SupplyOrder[]
  invoices             SalesInvoice[]
  guarantees           ContractGuarantee[]
  periods              ContractPeriod[]
  endorsements         ContractEndorsement[]
  amendments           ContractAmendment[]
  tasks                Task[]

  @@unique([id, caseId])
  @@unique([organizationId, instrumentType, reference])
  @@index([caseId])
  @@index([validUntil])
}

model ContractItem {
  id                String                    @id @default(cuid())
  caseId            String
  case              ContractCase              @relation(fields: [caseId], references: [id], onDelete: Restrict)
  opportunityItemId String?
  opportunityItem   OpportunityItem?          @relation(fields: [opportunityItemId], references: [id], onDelete: Restrict)
  number            Int
  description       String
  unit              String
  brand             String?
  model             String?
  quantity          Decimal                   @db.Decimal(18, 3)
  unitPrice         Decimal                   @db.Decimal(18, 4)
  sourceSnapshot    Json?
  orderItems        SupplyOrderItem[]
  invoiceItems      SalesInvoiceItem[]
  endorsementItems  ContractEndorsementItem[]
  amendmentItems    ContractAmendmentItem[]

  @@unique([caseId, number])
  @@unique([caseId, opportunityItemId])
  @@unique([id, caseId])
  @@index([opportunityItemId])
}

model SupplyOrder {
  id                 String            @id @default(cuid())
  caseId             String
  case               ContractCase      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  instrumentId       String
  instrument         Contract          @relation(fields: [instrumentId, caseId], references: [id, caseId], onDelete: Restrict)
  periodId           String?
  period             ContractPeriod?   @relation(fields: [periodId, caseId], references: [id, caseId], onDelete: Restrict)
  reference          String?
  commitmentNumber   String?
  commitmentIssuedAt DateTime?         @db.Date
  orderDate          DateTime          @db.Date
  deadline           DateTime?         @db.Date
  cancelled          Boolean           @default(false)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  items              SupplyOrderItem[]
  invoices           SalesInvoice[]

  @@unique([id, caseId])
  @@index([caseId])
  @@index([deadline])
}

model SupplyOrderItem {
  id                String             @id @default(cuid())
  caseId            String
  orderId           String
  order             SupplyOrder        @relation(fields: [orderId, caseId], references: [id, caseId], onDelete: Restrict)
  contractItemId    String
  contractItem      ContractItem       @relation(fields: [contractItemId, caseId], references: [id, caseId], onDelete: Restrict)
  unitPrice         Decimal?           @db.Decimal(18, 4)
  requestedQuantity Decimal            @db.Decimal(18, 3)
  suppliedQuantity  Decimal            @default(0) @db.Decimal(18, 3)
  invoiceItems      SalesInvoiceItem[]

  @@unique([orderId, contractItemId])
  @@unique([id, caseId])
}

model SalesInvoice {
  id           String             @id @default(cuid())
  caseId       String
  case         ContractCase       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  instrumentId String
  instrument   Contract           @relation(fields: [instrumentId, caseId], references: [id, caseId], onDelete: Restrict)
  periodId     String?
  period       ContractPeriod?    @relation(fields: [periodId, caseId], references: [id, caseId], onDelete: Restrict)
  orderId      String?
  order        SupplyOrder?       @relation(fields: [orderId, caseId], references: [id, caseId], onDelete: Restrict)
  reference    String
  accessKey    String?
  issueDate    DateTime           @db.Date
  amount       Decimal            @db.Decimal(18, 2)
  cancelled    Boolean            @default(false)
  documentUrl  String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  items        SalesInvoiceItem[]
  receipts     InvoiceReceipt[]

  @@unique([caseId, reference])
  @@unique([id, caseId])
}

model SalesInvoiceItem {
  id             String           @id @default(cuid())
  caseId         String
  invoiceId      String
  invoice        SalesInvoice     @relation(fields: [invoiceId, caseId], references: [id, caseId], onDelete: Restrict)
  contractItemId String
  contractItem   ContractItem     @relation(fields: [contractItemId, caseId], references: [id, caseId], onDelete: Restrict)
  orderItemId    String?
  orderItem      SupplyOrderItem? @relation(fields: [orderItemId, caseId], references: [id, caseId], onDelete: Restrict)
  description    String
  unit           String
  quantity       Decimal          @db.Decimal(18, 3)
  unitPrice      Decimal          @db.Decimal(18, 4)
  total          Decimal          @db.Decimal(18, 2)

  @@unique([invoiceId, contractItemId])
}

model InvoiceReceipt {
  id        String       @id @default(cuid())
  invoiceId String
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  date      DateTime     @db.Date
  amount    Decimal      @db.Decimal(18, 2)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([invoiceId])
}

model ContractGuarantee {
  id           String       @id @default(cuid())
  caseId       String
  case         ContractCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  instrumentId String
  instrument   Contract     @relation(fields: [instrumentId, caseId], references: [id, caseId], onDelete: Restrict)
  type         String
  amount       Decimal      @db.Decimal(18, 2)
  validUntil   DateTime     @db.Date
  status       String       @default("ACTIVE")
  documentUrl  String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([caseId])
  @@index([validUntil])
}

model ContractAmendment {
  id            String                  @id @default(cuid())
  caseId        String
  case          ContractCase            @relation(fields: [caseId], references: [id], onDelete: Restrict)
  instrumentId  String
  instrument    Contract                @relation(fields: [instrumentId, caseId], references: [id, caseId], onDelete: Restrict)
  reference     String
  date          DateTime                @db.Date
  type          String
  kind          AmendmentKind?
  renewalPeriod ContractPeriod?
  valueDelta    Decimal                 @default(0) @db.Decimal(18, 2)
  updatedAmount Decimal?                @db.Decimal(18, 2)
  newEndDate    DateTime?               @db.Date
  cancelled     Boolean                 @default(false)
  documentUrl   String?
  notes         String?
  createdAt     DateTime                @default(now())
  items         ContractAmendmentItem[]

  @@unique([instrumentId, reference])
  @@unique([id, caseId])
  @@index([newEndDate])
}

model ContractAmendmentItem {
  id             String            @id @default(cuid())
  caseId         String
  amendmentId    String
  amendment      ContractAmendment @relation(fields: [amendmentId, caseId], references: [id, caseId], onDelete: Restrict)
  contractItemId String
  contractItem   ContractItem      @relation(fields: [contractItemId, caseId], references: [id, caseId], onDelete: Restrict)
  quantityDelta  Decimal           @default(0) @db.Decimal(18, 3)
  unitPriceDelta Decimal           @default(0) @db.Decimal(18, 4)
  unitPrice      Decimal?          @db.Decimal(18, 4)

  @@unique([amendmentId, contractItemId])
}

enum AmendmentKind {
  ADDITION
  SUPPRESSION
  EXTENSION
  RENEWAL
  MIXED
}

enum EndorsementKind {
  ADJUSTMENT
  RENEGOTIATION
}

model ContractPeriod {
  id            String             @id @default(cuid())
  caseId        String
  case          ContractCase       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  instrumentId  String
  instrument    Contract           @relation(fields: [instrumentId, caseId], references: [id, caseId], onDelete: Restrict)
  number        Int
  startsAt      DateTime?          @db.Date
  endsAt        DateTime?          @db.Date
  amount        Decimal?           @db.Decimal(18, 2)
  itemsSnapshot Json
  renewalId     String?            @unique
  renewal       ContractAmendment? @relation(fields: [renewalId, caseId], references: [id, caseId], onDelete: Restrict)
  orders        SupplyOrder[]
  invoices      SalesInvoice[]

  @@unique([id, caseId])
  @@unique([caseId, number])
  @@unique([renewalId, caseId])
  @@index([endsAt])
}

model ContractEndorsement {
  id            String                    @id @default(cuid())
  caseId        String
  case          ContractCase              @relation(fields: [caseId], references: [id], onDelete: Restrict)
  instrumentId  String
  instrument    Contract                  @relation(fields: [instrumentId, caseId], references: [id, caseId], onDelete: Restrict)
  reference     String
  signatureDate DateTime                  @db.Date
  type          EndorsementKind
  documentUrl   String?
  notes         String?
  createdAt     DateTime                  @default(now())
  items         ContractEndorsementItem[]

  @@unique([id, caseId])
  @@unique([instrumentId, reference])
}

model ContractEndorsementItem {
  id             String              @id @default(cuid())
  caseId         String
  endorsementId  String
  endorsement    ContractEndorsement @relation(fields: [endorsementId, caseId], references: [id, caseId], onDelete: Restrict)
  contractItemId String
  contractItem   ContractItem        @relation(fields: [contractItemId, caseId], references: [id, caseId], onDelete: Restrict)
  unitPrice      Decimal             @db.Decimal(18, 4)

  @@unique([endorsementId, contractItemId])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

model Task {
  id             String        @id @default(cuid())
  title          String
  description    String?
  assigneeId     String?
  assignee       User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate        DateTime      @db.Date
  status         TaskStatus    @default(PENDING)
  priority       TaskPriority  @default(NORMAL)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  opportunityId  String?
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  contractId     String?
  contract       Contract?     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([dueDate, status])
  @@index([organizationId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([contractId])
  @@index([assigneeId])
}

model EventRead {
  actorId  String
  actor    User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  eventKey String
  readAt   DateTime @default(now())

  @@id([actorId, eventKey])
}

model OpportunityParticipant {
  opportunityId  String
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@id([opportunityId, organizationId])
  @@index([organizationId])
}

model PriceRegistration {
  id             String                  @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity             @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  reference      String
  signatureDate  DateTime                @db.Date
  validUntil     DateTime                @db.Date
  allowsAdhesion Boolean                 @default(false)
  documentUrl    String?
  notes          String?
  version        Int                     @default(1)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  items          PriceRegistrationItem[]

  @@unique([opportunityId, reference])
  @@unique([id, opportunityId])
  @@index([validUntil])
}

model PriceRegistrationItem {
  id             String            @id @default(cuid())
  registrationId String
  opportunityId  String
  registration   PriceRegistration @relation(fields: [registrationId, opportunityId], references: [id, opportunityId], onDelete: Cascade)
  sourceItemId   String
  sourceItem     OpportunityItem   @relation(fields: [sourceItemId, opportunityId], references: [id, opportunityId], onDelete: Restrict)
  number         Int
  description    String
  quantity       Decimal           @db.Decimal(18, 3)
  unitPrice      Decimal           @db.Decimal(18, 4)

  @@unique([registrationId, sourceItemId])
  @@index([sourceItemId, opportunityId])
}
